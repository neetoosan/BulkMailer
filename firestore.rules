rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Contact lists
      match /lists/{listId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Subscribers within a list
        match /subscribers/{subscriberId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Templates
      match /templates/{templateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Campaigns
      match /campaigns/{campaignId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Email jobs — readable by Cloud Functions (via admin SDK, bypasses rules)
    // and by the owning user for status tracking
    match /email_jobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Only Cloud Functions write here
    }
  }
}
